# Zerde 109 Intelligence Platform Configuration

# App
APP_NAME="Zerde 109 Intelligence Platform"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Neo4j Knowledge Graph (runs on CPU / System RAM)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme123
MAX_NEO4J_RESULTS=10

# Ollama LLM (runs on GPU RTX 4070 8GB VRAM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# NLP Pipeline (runs 100% on CPU Ryzen 7)
HYBRID_CONFIDENCE_THRESHOLD=0.85
KAZAKH_NLP_BACKEND=turkicnlp
RUSSIAN_NLP_BACKEND=natasha

# Verifier Thresholds
VERIFIER_ENTROPY_WINDOW=50
ENTROPY_Z_THRESHOLD=2.0
SEMANTIC_SIMILARITY_THRESHOLD=0.35
PERPLEXITY_THRESHOLD=500.0
