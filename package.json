{
  "name": "zerde109",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "check": "tsc -p packages/types --noEmit && tsc -p packages/ingest --noEmit && tsc -p apps/api --noEmit && tsc -p apps/web --noEmit",
    "dev:api": "npm run dev -w @zerde/api",
    "dev:web": "npm run dev -w @zerde/web",
    "dev:ai": "uvicorn src.api.api:app --app-dir ai --port 8000 --reload",
    "test:ai": "pytest ai/tests/ -v",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint .",
    "db:migrate": "npm run db:migrate -w @zerde/ingest",
    "db:seed": "npm run db:seed -w @zerde/ingest",
    "prepare:data": "npm run -s prepare:data -w @zerde/ingest --",
    "ingest": "npm run -s ingest -w @zerde/ingest --",
    "eval": "npm run -s eval -w @zerde/ingest",
    "smoke:api": "tsx apps/api/src/smoke.ts",
    "verify:data": "npm run verify:data -w @zerde/ingest"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "eslint": "^9.13.0",
    "typescript-eslint": "^8.11.0",
    "@eslint/js": "^9.13.0",
    "concurrently": "^9.0.1"
  }
}
